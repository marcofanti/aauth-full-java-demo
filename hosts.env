# Hostnames for the demo's named endpoints. Sourced by the scripts in scripts/;
# every value can be overridden from the environment before running
# (each line keeps an existing value: VAR="${VAR:-default}").
#
# The used hostnames must resolve to 127.0.0.1, e.g. in /etc/hosts:
#   127.0.0.1 portal.uma.lab gateway.uma.lab ps.uma.lab as.uma.lab sca.uma.lab maa.uma.lab
# AAuth draft-11 identifiers are https origins without a port: the PS, AS, SCA and MAA
# names are served by Caddy on :443 (caddy/Caddyfile, which binds these exact names).
#
# Java services receive these as --demo.* flags from run-demo.sh; their own
# application.properties defaults carry the same names for manual runs.
# The Caddyfiles (caddy/, docker/), gateway YAMLs (gateway/) and docker-compose keep literal
# names — signed authorities and compose aliases are coupled to them.

DEMO_PORTAL_HOST="${DEMO_PORTAL_HOST:-portal.uma.lab}"   # backend API + UI origin (plain http)
DEMO_PS_HOST="${DEMO_PS_HOST:-ps.uma.lab}"               # Person Server, https via Caddy
DEMO_AS_HOST="${DEMO_AS_HOST:-as.uma.lab}"               # Agent Server (co-located with the PS)
DEMO_SCA_HOST="${DEMO_SCA_HOST:-sca.uma.lab}"            # supply-chain agent, https via Caddy
DEMO_MAA_HOST="${DEMO_MAA_HOST:-maa.uma.lab}"            # market-analysis agent, https via Caddy
DEMO_GATEWAY_HOST="${DEMO_GATEWAY_HOST:-gateway.uma.lab}" # edge gateway (draft-10 edge modes)

# Reserved names from the original uma.lab set; nothing references these yet.
DEMO_GRAFANA_HOST="${DEMO_GRAFANA_HOST:-grafana.uma.lab}"
DEMO_KEYCLOAK_HOST="${DEMO_KEYCLOAK_HOST:-keycloak.uma.lab}"
DEMO_ALICE_AS_HOST="${DEMO_ALICE_AS_HOST:-alice-as.uma.lab}"
